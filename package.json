{
  "name": "compilex-cmpx-token",
  "version": "0.3.0",
  "description": "CompileX (CMPX): Bitcoin-inspired fixed-supply ERC-20 token, Sepolia deployment, tests and developer documentation.",
  "private": true,
  "scripts": {
    "clean": "hardhat clean",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "transfer": "hardhat run scripts/transfer.ts --network sepolia",
    "verify:sepolia": "hardhat verify --network sepolia"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "dotenv": "16.4.7"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "6.1.0",
    "@types/node": "22.10.2",
    "hardhat": "2.28.6",
    "ts-node": "10.9.2",
    "typescript": "5.7.2"
  },
  "license": "MIT"
}
