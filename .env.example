# CompileX / CMPX
# Copy this file to .env and fill in your own values.
# Never commit .env, private keys, seed phrases or main-wallet credentials.

SEPOLIA_RPC_URL="https://sepolia.infura.io/v3/YOUR_KEY"
PRIVATE_KEY="0xYOUR_TEST_WALLET_PRIVATE_KEY"
ETHERSCAN_API_KEY="YOUR_ETHERSCAN_API_KEY"

# Optional. Defaults to deployer address.
# This address receives the full fixed 21,000,000 CMPX supply at deployment.
INITIAL_RECEIVER="0xYOUR_INITIAL_RECEIVER_ADDRESS"

# Current verified Sepolia deployment:
TOKEN_ADDRESS="0xa1A09ba7357c5187d90E1De160bFd868151f3D8C"

# Optional transfer.ts settings:
TRANSFER_TO="0xRECIPIENT_ADDRESS"
TRANSFER_AMOUNT="10"
